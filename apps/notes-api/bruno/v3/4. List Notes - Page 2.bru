meta {
  name: 4. List Notes - Page 2
  type: http
  seq: 4
}

get {
  url: {{baseUrlV3}}/notes?page=2&limit=10
  body: none
  auth: none
}

params:query {
  page: 2
  limit: 10
}

docs {
  Jump directly to any page by number — the one thing no cursor-based
  approach (v1/v2) can do. Compare `links.first`/`links.last` in the
  response against "2. List Notes - Basic (Page 1)"'s — they're always
  present (re-requesting the page you're on is a no-op, not an error),
  unlike `links.previous`/`next` which are `null` at the respective ends.
}

script:post-response {
  if (res.body && res.body.links) {
    bru.setVar("v3PreviousLink", res.body.links.previous);
    bru.setVar("v3LastLink", res.body.links.last);
  }
}
