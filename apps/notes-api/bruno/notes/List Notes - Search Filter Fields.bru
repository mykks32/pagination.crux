meta {
  name: List Notes - Search Filter Fields
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/notes?first=10&search=note&filters={"tags":"personal"}&sort=title&order=asc&include=title,tags
  body: none
  auth: none
}

params:query {
  first: 10
  search: note
  filters: {"tags":"personal"}
  sort: title
  order: asc
  include: title,tags
}

docs {
  Demonstrates the generic CursorPaginationDto surface: free-text `search`
  (backed by a MongoDB text index), a whitelisted ad-hoc `filters` object
  (JSON-encoded), `sort`/`order`, and a sparse fieldset via `include`
  (every item in `data` comes back as just `{ id, title, tags }`).
}
