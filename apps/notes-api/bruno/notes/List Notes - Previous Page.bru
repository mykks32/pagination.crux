meta {
  name: List Notes - Previous Page
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/notes?last=10&before={{startCursor}}
  body: none
  auth: none
}

params:query {
  last: 10
  before: {{startCursor}}
}

docs {
  Backward pagination — pages toward the start of the list using
  `meta.startCursor` captured from a previous list request.
}

script:post-response {
  if (res.body && res.body.meta) {
    bru.setVar("endCursor", res.body.meta.endCursor);
    bru.setVar("startCursor", res.body.meta.startCursor);
  }
}
