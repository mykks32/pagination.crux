{
  "name": "notes-api",
  "version": "0.1.0",
  "private": true,
  "description": "Demo NestJS + Mongoose REST API showing full Notes CRUD and cursor pagination via pagination",
  "author": "Shree Krishna Yadav",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "seed": "ts-node -r dotenv/config scripts/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"{src,scripts,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,scripts,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,scripts,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.ts\""
  },
  "dependencies": {
    "@mykks32/pagination": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.22",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mongoose": "^8.24.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
