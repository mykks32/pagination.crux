{
  "name": "pagination-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo: packages/pagination (cursor pagination library) + apps/notes-api (NestJS demo app consuming it)",
  "author": "Shree Krishna Yadav",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov",
    "lint": "eslint \"{packages,apps}/*/{src,scripts,test}/**/*.ts\"",
    "lint:fix": "eslint \"{packages,apps}/*/{src,scripts,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{packages,apps}/*/{src,scripts,test}/**/*.ts\"",
    "format:check": "prettier --check \"{packages,apps}/*/{src,scripts,test}/**/*.ts\"",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0"
  }
}
